# ─────────────────────────────────────────────────────────────
#  CYRIL'S FOODS — SERVER CONFIGURATION
#  Copy this file to ".env" and fill in your real values.
#  NEVER commit the real .env file. Restart the server after edits.
# ─────────────────────────────────────────────────────────────

# 🔒 KITCHEN PORTAL — magic-link (passwordless) auth
# Authorized staff inbox(es) that may receive sign-in links (comma-separated).
KITCHEN_EMAILS=kitchen@cyrilfoods.com.ng,michaelnwankwo186@gmail.com
# Public URL of THIS BACKEND (used to build the magic-link verification route).
# On Render this is your service URL, e.g. https://cyrils-foods.onrender.com
PUBLIC_URL=
# Public URL of the CUSTOMER-FACING STATIC SITE (Netlify). Magic links redirect
# here after verification so the 24h token is stored under the site origin.
# If you serve the whole site from the backend (same origin), leave blank.
FRONTEND_URL=https://cyrilfoods.netlify.app
# Email delivery: the sign-in link is POSTed as JSON {to,subject,text,html} to
# this webhook (Resend/Brevo/Mailgun/Zapier). Optional — if blank, the link is
# printed to the SERVER LOG (fine for local/dev; on Render check the Logs tab).
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_KEY=
# Break-glass PIN (not shown in the UI) for emergency access / local dev.
KITCHEN_PIN=8818

# CORS: comma-separated list of front-end origins allowed to call this API.
# Restrict to your real origins — NEVER use * on a public order/auth backend.
CORS_ORIGIN=https://cyrilfoods.netlify.app,https://cyrilsfood.com.ng,https://www.cyrilsfood.com.ng
#
# ── Pointing the STATIC front-end (Netlify) at this backend ──
# Edit config.js in the site repo and set the production API base to this
# server's public URL, e.g.  return "https://cyrils-foods.onrender.com";
# (localhost is auto-detected and always uses :3000.)
#
# ── Or use Supabase Auth for magic links with NO backend ──
# Set window.CYRIL_SUPABASE_URL and window.CYRIL_SUPABASE_ANON_KEY in config.js;
# the staff modal will then call supabase.auth.signInWithOtp().

# (Optional but recommended) Random long string used to sign staff
# login tokens. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left blank, the server derives one automatically.
TOKEN_SECRET=

# ── Payments (Paystack) ──────────────────────────────────────
# Live keys from https://dashboard.paystack.com → Settings → API Keys
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ── WhatsApp alerts (optional — wa.me deep link works without these) ──
# Twilio WhatsApp:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_ALERT_TO=whatsapp:+2348081988184
# …or Green API (https://green-api.com):
GREEN_API_INSTANCE=
GREEN_API_TOKEN=
GREEN_API_CHAT_ID=2348081988184@c.us

# ── Delivery (defaults are already correct) ──────────────────
# REST_ADDRESS=26 College Rd, Ifako-Ijaiye, Lagos, Nigeria
# REST_LAT=6.6427
# REST_LNG=3.3288
# RATE_PER_KM=1100
