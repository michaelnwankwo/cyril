# ── Cyril's Foods backend configuration ──
# Copy to `.env` and fill in. Export these in your shell / host dashboard.

# Server
PORT=3000

# Paystack (https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=sk_live_or_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Public key is also exposed to the browser (app.js reads window.CYRIL_PAYSTACK_PK).
PAYSTACK_PUBLIC_KEY=pk_live_or_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WhatsApp instant alerts — provider 1: Twilio WhatsApp channel
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_ALERT_TO=whatsapp:+2348081988184

# WhatsApp instant alerts — provider 2: Green API (green-api.com)
GREEN_API_INSTANCE=
GREEN_API_TOKEN=
GREEN_API_CHAT_ID=2348081988184@c.us

# Restaurant fixed origin for distance calculations (Lagos default)
REST_LAT=6.5244
REST_LNG=3.3792
RATE_PER_KM=1100

# Google Maps (browser) — optional; OSRM/Photon are used as free fallback
# Set in index.html:  window.CYRIL_GOOGLE_MAPS_KEY = "AIza...";
# and  window.CYRIL_PAYSTACK_PK = "pk_...";
