# ─────────────────────────────────────────────────────────────
#  CYRIL'S FOODS — SERVER CONFIGURATION
#  Copy this file to ".env" and fill in your real values.
#  NEVER commit the real .env file. Restart the server after edits.
# ─────────────────────────────────────────────────────────────

# 🔒 KITCHEN PORTAL — magic-link (passwordless) auth
# Authorized staff inbox(es) that may receive sign-in links (comma-separated).
KITCHEN_EMAILS=kitchen@cyrilfoods.com.ng
# Public URL of the site (used to build the link inside the email). Set to your
# real domain in production, e.g. https://orders.cyrilsfood.com.ng
PUBLIC_URL=
# Email delivery: the sign-in link is POSTed as JSON {to,subject,text,html} to
# this webhook (Resend/Brevo/Mailgun/Zapier). Optional — if blank, the link is
# printed to the SERVER LOG (fine for a VPS where staff can read logs/dev).
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_KEY=
# Break-glass PIN (not shown in the UI) for emergency access / local dev.
KITCHEN_PIN=8818

# CORS: comma-separated list of front-end origins allowed to call this API
# (e.g. https://cyrilfoods.netlify.app). Leave as * to allow any origin.
CORS_ORIGIN=*
#
# ── Pointing a STATIC front-end (Netlify drop) at this backend ──
# In the site's HTML/JS set window.CYRIL_API_BASE to this server's public URL,
# e.g.  window.CYRIL_API_BASE = "https://cyrils-api.onrender.com";
#
# ── Or use Supabase Auth for magic links with NO backend ──
# Set window.CYRIL_SUPABASE_URL and window.CYRIL_SUPABASE_ANON_KEY in the
# front-end; the staff modal will then call supabase.auth.signInWithOtp().
PUBLIC_URL=https://your-backend-or-site.example.com

# (Optional but recommended) Random long string used to sign staff
# login tokens. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left blank, the server derives one automatically.
TOKEN_SECRET=

# ── Payments (Paystack) ──────────────────────────────────────
# Live keys from https://dashboard.paystack.com → Settings → API Keys
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ── WhatsApp alerts (optional — wa.me deep link works without these) ──
# Twilio WhatsApp:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_ALERT_TO=whatsapp:+2348081988184
# …or Green API (https://green-api.com):
GREEN_API_INSTANCE=
GREEN_API_TOKEN=
GREEN_API_CHAT_ID=2348081988184@c.us

# ── Delivery (defaults are already correct) ──────────────────
# REST_ADDRESS=26 College Rd, Ifako-Ijaiye, Lagos, Nigeria
# REST_LAT=6.6427
# REST_LNG=3.3288
# RATE_PER_KM=1100
# PORT=3000
